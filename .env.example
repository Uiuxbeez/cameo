# SERVER ONLY. Never use VITE_ for secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Optional direct endpoint for migrations; otherwise derived from DATABASE_URL.
DIRECT_DATABASE_URL=
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
ADMIN_EMAIL=admin@cameoadv.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
